{
  "name": "faune-france-playwright-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "node --env-file-if-exists=.env --import tsx src/login.ts",
    "search": "node --env-file-if-exists=.env --import tsx src/search.ts",
    "test-search": "node --env-file-if-exists=.env --import tsx src/test-search.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "export-taxa": "node --env-file-if-exists=.env --import tsx src/export-taxa.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "install-browser": "playwright install firefox"
  },
  "dependencies": {
    "playwright": "^1.54.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
