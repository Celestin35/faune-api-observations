APP_NAME="Observations API Audit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=observations
DB_USERNAME=observations
DB_PASSWORD=observations

BIODIVERSITY_USER_AGENT="observations-api-audit/0.1 (contact: replace-me@example.test)"
BIODIVERSITY_MIN_INTERVAL_MS=500
BIODIVERSITY_IMPORT_LIMIT=10000
MONITORING_HISTORY_MONTHS=2
MAP_OBSERVATION_LIMIT=30000
INATURALIST_IMPORT_PAUSE_MS=0
INATURALIST_IMPORT_PAGE_SIZE=200
GEOCODING_AUTOCOMPLETE_URL=https://data.geopf.fr/geocodage/completion/
ADMINISTRATIVE_GEOCODING_URL=https://geo.api.gouv.fr/communes
ELEVATION_URL=https://data.geopf.fr/altimetrie/1.0/calcul/alti/rest/elevation.json
ELEVATION_RESOURCE=ign_rge_alti_wld
GEOGRAPHY_ENRICHMENT_BATCH_SIZE=50
QUEUE_CONNECTION=database
FAUNE_FRANCE_TOKEN=replace-with-a-local-secret
FAUNE_FRANCE_BOT_TOKEN=
FAUNE_FRANCE_BOT_STALE_SECONDS=300
FAUNE_FRANCE_MAX_PAGES=200
FAUNE_FRANCE_PAGE_PAUSE_MS=0
DB_QUEUE_RETRY_AFTER=1200
OBIS_ENABLED=false
EBIRD_API_KEY=
GEONATURE_BASE_URL=
