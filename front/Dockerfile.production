FROM node:22-alpine AS build

WORKDIR /front

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:22-alpine

WORKDIR /front
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

COPY --from=build /front/.output ./.output

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
